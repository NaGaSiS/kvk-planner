# =====================================================
# KVK Planner - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# =====================================================

# --- Security ---
# Random string for Flask session encryption (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-secret-string

# PIN that admins enter to access the event dashboard
ADMIN_PIN=your-admin-pin-here

# Secret token for the superadmin console (/superadmin?secret=...)
SUPERADMIN_SECRET=your-superadmin-secret-here

# --- AI Image Analysis (optional) ---
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API key (optional, alternative AI provider)
GROQ_API_KEY=

# --- Database ---
# Leave as default if using Docker volumes
DATABASE_PATH=/app/data/planner.db

# --- Docker ports & paths (for docker-compose) ---
# Port exposed on the host machine
HOST_PORT=12348

# Unraid: use absolute paths on your array, e.g.:
# DATA_PATH=/mnt/user/appdata/kvk-planner/data
# UPLOADS_PATH=/mnt/user/appdata/kvk-planner/uploads
# LOGS_PATH=/mnt/user/appdata/kvk-planner/logs
DATA_PATH=./data
UPLOADS_PATH=./uploads
LOGS_PATH=./logs
